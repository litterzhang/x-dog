{
  "name": "tools-script-workflow",
  "provider": "copilot",
  "entry": "prep",
  "defaults": {
    "model": "claude-sonnet-4.5"
  },
  "state": {
    "topic": "workflow engines"
  },
  "nodes": [
    {
      "id": "prep",
      "type": "script",
      "run": "flow.tools:passthrough",
      "output": "prepped"
    },
    {
      "id": "analyze",
      "type": "agent",
      "tools": ["echo"],
      "inputs": ["prepped"],
      "system_prompt": "You analyse.",
      "prompt": "Analyse: {{prepped}}",
      "output": "analysis"
    }
  ],
  "edges": [
    {"from": "prep", "to": "analyze"}
  ]
}
