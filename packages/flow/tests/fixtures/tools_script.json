{
  "name": "tools-script-workflow",
  "provider": "copilot",
  "entry": "prep",
  "defaults": {
    "model": "claude-sonnet-4.5"
  },
  "state": {
    "topic": "workflow engines"
  },
  "nodes": [
    {
      "id": "prep",
      "type": "script",
      "inputs": [{"name": "topic", "schema": {"type": "string"}}],
      "code": "def prep(ctx, topic):\n    return topic",
      "outputs": [{"name": "prepped", "schema": {"type": "string"}}]
    },
    {
      "id": "analyze",
      "type": "agent",
      "tools": ["echo"],
      "inputs": ["prepped"],
      "system_prompt": "You analyse.",
      "prompt": "Analyse: {{prepped}}",
      "outputs": ["analysis"]
    }
  ],
  "edges": [
    {"from": "$in", "to": "prep", "map": {"topic": "topic"}},
    {"from": "prep", "to": "analyze", "map": {"prepped": "prepped"}}
  ]
}
