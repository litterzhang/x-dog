{
  "name": "auto-enrich",
  "provider": "copilot",
  "defaults": {
    "model": "claude-sonnet-4.5"
  },
  "entry": "pull",
  "state": {
    "topic": "DePIN project Helium needs category, token, summary"
  },
  "nodes": [
    {
      "id": "pull",
      "type": "script",
      "inputs": [{"name": "topic", "type": "string"}],
      "code": "def pull(ctx, topic):\n    return topic",
      "outputs": [{"name": "record", "type": "string"}]
    },
    {
      "id": "enrich",
      "type": "agent",
      "inputs": ["record"],
      "system_prompt": "You are a data-enrichment agent. Fill missing fields precisely; do not invent facts.",
      "prompt": "Enrich this record, filling every field:\n\n{{record}}",
      "outputs": ["enriched"],
      "output_schema": {
        "category": "string",
        "token": "string",
        "summary": "string"
      }
    },
    {
      "id": "persist",
      "type": "script",
      "inputs": [{"name": "record", "type": "string"}],
      "code": "def persist(ctx, record):\n    return record",
      "outputs": [{"name": "saved", "type": "string"}]
    }
  ],
  "edges": [
    {"from": "$in", "to": "pull", "map": {"topic": "topic"}},
    {"from": "pull", "to": "enrich", "map": {"record": "record"}},
    {"from": "pull", "to": "persist", "map": {"record": "record"}}
  ]
}
