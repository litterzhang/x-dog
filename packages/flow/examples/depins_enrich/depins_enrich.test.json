{
  "cases": [
    {
      "name": "approved change is committed and pushed",
      "inputs": {
        "repo": "/fixture/depins",
        "venv_bin": "/fixture/depins/.venv/bin",
        "remote": "origin",
        "branch": "main",
        "min_hours": 3,
        "stress_rounds": 2,
        "state_dir": "/fixture/ae"
      },
      "scripts": {
        "precheck": {
          "proceed": true,
          "reason": "",
          "repo": "/fixture/depins",
          "venv_bin": "/fixture/depins/.venv/bin",
          "remote": "origin",
          "branch": "main",
          "head": "abc1234",
          "ruff_baseline": 0,
          "known_json": "{\"projects\":[],\"slugs\":[],\"features\":[]}",
          "builder_prompt": "add one thing",
          "validator_prompt": "review it",
          "stress_rounds": 2,
          "state_dir": "/fixture/ae"
        },
        "scope": {
          "scope": "{\"changed\":[\"src/depins/x.py\"],\"summary\":\"add /api endpoint\",\"id\":\"api-x\",\"is_feature\":true,\"diff\":\"+x\"}"
        },
        "guards": {
          "guards": "{\"ok\":true,\"kind\":\"feature\",\"id\":\"api-x\"}"
        },
        "commit": {
          "outcome": "pushed",
          "detail": "feature 'api-x' -> def5678",
          "head": "def5678"
        },
        "revert": {
          "outcome": "rejected",
          "detail": "reverted",
          "head": "abc1234"
        },
        "gate": {
          "verdict": "PASS: clean"
        }
      },
      "agents": {
        "build": {
          "report": "added the endpoint"
        },
        "validate": {
          "review": "Looks right.\n{\"verdict\":\"approve\",\"reasons\":\"claims check out\"}"
        },
        "fix": {
          "note": "should not run"
        }
      },
      "expect": {
        "output": {
          "outcome": "pushed",
          "head": "def5678"
        },
        "calls": {
          "decide": 1,
          "fix": 0,
          "commit": 1,
          "revert": 0
        }
      }
    },
