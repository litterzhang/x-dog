{
  "cases": [
    {
      "name": "first run writes the charter and stops there",
      "inputs": {
        "idea": "A JSON API that stores short notes."
      },
      "scripts": {
        "survey": {
          "active": "yes",
          "has_charter": "no",
          "unmet_count": 0,
          "unmet": "",
          "run_no": 1,
          "status": "no charter yet",
          "source_dir": "/srv/notes"
        }
      },
      "agents": {
        "charter": {
          "charter_summary": "7 criteria, checked by `python -m pytest -q`"
        }
      },
      "expect": {
        "success": true,
        "output": {
          "charter": "7 criteria, checked by `python -m pytest -q`",
          "status": "no charter yet"
        }
      }
    },
    {
      "name": "a working run proposes one increment, builds it, and ticks the criterion",
      "inputs": {
        "idea": "ignored once a charter exists"
      },
      "scripts": {
        "survey": {
          "active": "yes",
          "has_charter": "yes",
          "unmet_count": 5,
          "unmet": "- health-endpoint: GET /health returns 200",
          "run_no": 4,
          "status": "run 4: 5 of 7 criteria unmet",
          "source_dir": "/srv/notes"
        },
        "verify": {
          "passed": "yes",
          "report": "$ pytest -q\nexit=0\n9 passed"
        },
        "record": {
          "outcome": "met health-endpoint",
          "halted": ""
        },
        "commit": {
          "committed": "committed and pushed: run 4: met health-endpoint"
        }
      },
      "agents": {
        "propose": {
          "criterion": "health-endpoint",
          "task": "add GET /health returning 200, with a test",
          "source_dir": "/srv/notes"
        },
        "implement": {
          "changes": "app/health.py, tests/test_health.py"
        }
      },
      "expect": {
        "success": true,
        "output": {
          "outcome": "met health-endpoint",
          "halted": "",
          "status": "run 4: 5 of 7 criteria unmet",
          "committed": "committed and pushed: run 4: met health-endpoint"
        }
      }
    },
    {
      "name": "failing checks send the increment back to the same agent, which remembers",
      "inputs": {
        "idea": "ignored"
      },
      "scripts": {
        "survey": {
          "active": "yes",
          "has_charter": "yes",
          "unmet_count": 1,
          "unmet": "- create-note: POST /notes returns an id",
          "run_no": 6,
          "status": "run 6: 1 of 7 criteria unmet",
          "source_dir": "/srv/notes"
        },
        "verify": [
          {
            "round": 1,
            "then": {
              "passed": "no",
              "report": "exit=1\nAssertionError: got 500"
            }
          },
          {
            "round": 2,
            "then": {
              "passed": "yes",
              "report": "exit=0\n11 passed"
            }
          }
        ],
        "record": {
          "outcome": "met create-note",
          "halted": ""
        },
        "commit": {
          "committed": "committed and pushed: run 4: met health-endpoint"
        }
      },
      "agents": {
        "propose": {
          "criterion": "create-note",
          "task": "POST /notes",
          "source_dir": "/srv/notes"
        },
        "implement": [
          {
            "round": 1,
            "then": {
              "changes": "first attempt"
            }
          },
          {
            "round": 2,
            "then": {
              "changes": "fixed the 500"
            }
          }
        ]
      },
      "expect": {
        "success": true,
        "output": {
          "outcome": "met create-note",
          "halted": "",
          "committed": "committed and pushed: run 4: met health-endpoint"
        }
      }
    },
    {
      "name": "a halted project costs nothing to keep firing",
      "inputs": {
        "idea": "ignored"
      },
      "scripts": {
        "survey": {
          "active": "no",
          "has_charter": "yes",
          "unmet_count": 0,
          "unmet": "",
          "run_no": 12,
          "status": "complete: every acceptance criterion is met",
          "source_dir": "/srv/notes"
        }
      },
      "expect": {
        "success": true,
        "output": {
          "status": "complete: every acceptance criterion is met"
        }
      }
    }
  ]
}
