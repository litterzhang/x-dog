{
  "name": "tools-script-workflow",
  "provider": "copilot",
  "entry": "prep",
  "defaults": {
    "model": "claude-sonnet-4.6"
  },
  "state": {
    "topic": "workflow engines"
  },
  "nodes": [
    {
      "id": "prep",
      "type": "script",
      "inputs": [{"name": "topic", "type": "string"}],
      "code": "def prep(ctx, topic):\n    return topic",
      "outputs": [{"name": "prepped", "type": "string"}]
    },
    {
      "id": "analyze",
      "type": "agent",
      "inputs": ["prepped"],
      "tools": ["echo"],
      "system_prompt": "You are an analyst.",
      "prompt": "Analyse the topic below:\n\n{{prepped}}",
      "outputs": ["analysis"]
    }
  ],
  "edges": [
    {"from": "$in", "to": "prep", "map": {"topic": "topic"}},
    {"from": "prep", "to": "analyze", "map": {"prepped": "prepped"}}
  ]
}
