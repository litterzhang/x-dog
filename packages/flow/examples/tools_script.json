{
  "name": "tools-script-workflow",
  "provider": "copilot",
  "entry": "prep",
  "defaults": {
    "model": "claude-sonnet-4.5"
  },
  "state": {
    "topic": "workflow engines"
  },
  "nodes": [
    {
      "id": "prep",
      "type": "script",
      "code": "def prep(ctx):\n    return ctx.state.get('topic', '')",
      "output": {"name": "prepped", "type": "string"}
    },
    {
      "id": "analyze",
      "type": "agent",
      "tools": ["echo"],
      "system_prompt": "You are an analyst.",
      "prompt": "Analyse the topic below:\n\n{{prepped}}",
      "output": "analysis"
    }
  ],
  "edges": [
    {"from": "prep", "to": "analyze"}
  ]
}
