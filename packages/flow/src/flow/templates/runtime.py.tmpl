# Node-private outputs: _OUT[node_id][port] = value.  The reserved source node
# carries the workflow's initial values.
_OUT: dict[str, dict[str, str]] = $in_seed
# Per-node execution trace (delta frames) and the collected workflow output.
_STACK: list[dict[str, object]] = []
_OUTPUT: dict[str, str] = {}
# Completed node ids (used for checkpoint/resume).
_COMPLETED: set[str] = set()
