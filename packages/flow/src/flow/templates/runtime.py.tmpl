"""$workflow_name — generated workflow module."""

import asyncio
import json

import ai
from agent import Agent
from agent.core import AgentConfig, AgentTool, StreamFn
from agent.events import TurnEndEvent
from agent.helpers import stream_fn_from_provider
from ai.types import AssistantMessage, TextContent
$script_imports
# Node-private outputs: _OUT[node_id][port] = value.  The reserved source node
# carries the workflow's initial values.
_OUT: dict[str, dict[str, str]] = $in_seed
# Per-node execution trace (delta frames) and the collected workflow output.
_STACK: list[dict[str, object]] = []
_OUTPUT: dict[str, str] = {}
# The runtime container, populated by main() (see ExecResult.runtime).
_RUNTIME: dict[str, object] = {}

_REGISTRY = default_registry()$tool_registration


async def _run_agent(
    provider: object, model: str, system_prompt: str, prompt: str, tools: tuple[AgentTool, ...] = ()
) -> str:
    stream_fn: StreamFn = stream_fn_from_provider(provider)  # type: ignore[arg-type]
    agent = Agent(stream_fn, config=AgentConfig(model=model, system_prompt=system_prompt), tools=tools)
    accumulated: list[str] = []
    event_stream = await agent.prompt(prompt)
    async for event in event_stream:
        if isinstance(event, TurnEndEvent) and event.message is not None:
            msg = event.message
            if isinstance(msg, AssistantMessage):
                for part in msg.content:
                    if isinstance(part, TextContent):
                        accumulated.append(part.text)
    return "".join(accumulated)


$node_functions


async def main() -> None:
    provider = ai.provider("$provider")
$main_body
    _last = _STACK[-1] if _STACK else {"step": -1, "node": ""}
    _RUNTIME.update(
        {
            "ctx": {"step": _last["step"], "node_id": _last["node"], "workflow_name": "$workflow_name"},
            "stack": _STACK,
            "state": {_k: _v for _k, _v in _OUT.items() if _k != $in_node_id},
            "in": _OUT[$in_node_id],
            "out": _OUTPUT,
        }
    )
    print(json.dumps(_RUNTIME["out"] if _RUNTIME["out"] else _RUNTIME, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    asyncio.run(main())
