# ---------------------------------------------------------------------------
# Checkpoint helpers — active only when FLOW_RUN_ID + FLOW_CHECKPOINT_DIR set.
# ---------------------------------------------------------------------------
_FLOW_RUN_ID: str | None = None
_FLOW_CHECKPOINT_DIR: str | None = None


def _checkpoint_path() -> Path | None:
    if _FLOW_RUN_ID and _FLOW_CHECKPOINT_DIR:
        return Path(_FLOW_CHECKPOINT_DIR) / f"{_FLOW_RUN_ID}.json"
    return None


def _load_checkpoint() -> None:
    p = _checkpoint_path()
    if p is None or not p.exists():
        return
    with p.open(encoding="utf-8") as _fh:
        _snap: dict[str, object] = json.load(_fh)
    _out = _snap.get("outputs")
    if isinstance(_out, dict):
        _OUT.clear()
        _OUT.update(_out)  # type: ignore[arg-type]
    _done = _snap.get("completed")
    if isinstance(_done, list):
        _COMPLETED.update(_done)  # type: ignore[arg-type]
    _stk = _snap.get("stack")
    if isinstance(_stk, list):
        _STACK.extend(_stk)  # type: ignore[arg-type]
    _outp = _snap.get("out_live")
    if isinstance(_outp, dict):
        _OUTPUT.update(_outp)  # type: ignore[arg-type]
    _mem = _snap.get("memo")
    if isinstance(_mem, dict):
        for _mk, _mv in _mem.items():
            if isinstance(_mv, dict):
                _MEMO[str(_mk)] = dict(_mv)  # type: ignore[arg-type]
    global _TOKENS_USED
    _tok = _snap.get("tokens_used")
    if isinstance(_tok, int):
        _TOKENS_USED = _tok


def _save_checkpoint() -> None:
    p = _checkpoint_path()
    if p is None:
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    _snap = {
        "outputs": _OUT,
        "completed": list(_COMPLETED),
        "stack": _STACK,
        "out_live": _OUTPUT,
        "memo": _MEMO,
        "tokens_used": _TOKENS_USED,
    }
    _fd, _tmp = tempfile.mkstemp(dir=p.parent, suffix=".tmp")
    try:
        with os.fdopen(_fd, "w", encoding="utf-8") as _fh:
            json.dump(_snap, _fh, ensure_ascii=False)
        os.replace(_tmp, p)
    except Exception:
        try:
            os.unlink(_tmp)
        except OSError:
            pass
        raise


async def _run_agent(
    provider: object,
    model: str,
    system_prompt: str,
    prompt: str,
    tools: tuple[AgentTool, ...] = (),
    output_schema: tuple[tuple[str, str], ...] = (),
    web_search_model: str | None = None,
) -> tuple[str, int]:
    stream_fn: StreamFn = stream_fn_from_provider(provider)  # type: ignore[arg-type]
    # Structured output: register submit_result + a result sink, and instruct the
    # agent to call it.  The submitted object becomes the node's JSON output.
    _sink: dict[str, object] = {}
    _tool_ctx: dict[str, object] | None = None
    _sys = system_prompt
    if output_schema:
        tools = tools + (create_submit_result_tool(),)
        _tool_ctx = {"flow_output_schema": dict(output_schema), "flow_result_sink": _sink}
        _fields = ", ".join(_f for _f, _ in output_schema)
        _sys = system_prompt + (
            "\nWhen finished, you MUST call the submit_result tool"
            f" with an object containing these fields: {_fields}."
        )
    # Built-in web_search tool (search model may differ from the node model).
    _web_search_fn: Callable[[str], Awaitable[str]] | None = None
    if web_search_model is not None:
        _web_search_fn = web_search_fn_from_provider(provider, web_search_model)  # type: ignore[arg-type]
    agent = Agent(
        stream_fn,
        config=AgentConfig(model=model, system_prompt=_sys),
        tools=tools,
        tool_ctx=_tool_ctx,
        web_search_fn=_web_search_fn,
    )
    accumulated: list[str] = []
    _node_tokens = 0
    event_stream = await agent.prompt(prompt)
    async for event in event_stream:
        if isinstance(event, TurnEndEvent) and event.message is not None:
            msg = event.message
            if isinstance(msg, AssistantMessage):
                for part in msg.content:
                    if isinstance(part, TextContent):
                        accumulated.append(part.text)
                _u = msg.usage
                _node_tokens += _u.total_tokens or (_u.input + _u.output)
    if output_schema:
        _result_obj = _sink.get("result")
        if _result_obj is None:
            raise WorkflowExecutionError("agent did not submit a result via submit_result")
        return json.dumps(_result_obj, ensure_ascii=False, sort_keys=True), _node_tokens
    return "".join(accumulated), _node_tokens


