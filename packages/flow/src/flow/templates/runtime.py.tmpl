# ---------------------------------------------------------------------------
# Checkpoint helpers — active only when FLOW_RUN_ID + FLOW_CHECKPOINT_DIR set.
# ---------------------------------------------------------------------------
_FLOW_RUN_ID: str | None = None
_FLOW_CHECKPOINT_DIR: str | None = None


def _checkpoint_path() -> Path | None:
    if _FLOW_RUN_ID and _FLOW_CHECKPOINT_DIR:
        return Path(_FLOW_CHECKPOINT_DIR) / f"{_FLOW_RUN_ID}.json"
    return None


def _load_checkpoint() -> None:
    p = _checkpoint_path()
    if p is None or not p.exists():
        return
    with p.open(encoding="utf-8") as _fh:
        _snap: dict[str, object] = json.load(_fh)
    _out = _snap.get("outputs")
    if isinstance(_out, dict):
        _OUT.clear()
        _OUT.update(_out)  # type: ignore[arg-type]
    _done = _snap.get("completed")
    if isinstance(_done, list):
        _COMPLETED.update(_done)  # type: ignore[arg-type]
    _stk = _snap.get("stack")
    if isinstance(_stk, list):
        _STACK.extend(_stk)  # type: ignore[arg-type]
    _outp = _snap.get("out_live")
    if isinstance(_outp, dict):
        _OUTPUT.update(_outp)  # type: ignore[arg-type]
    _mem = _snap.get("memo")
    if isinstance(_mem, dict):
        for _mk, _mv in _mem.items():
            if isinstance(_mv, dict):
                _MEMO[str(_mk)] = dict(_mv)  # type: ignore[arg-type]
    global _TOKENS_USED
    _tok = _snap.get("tokens_used")
    if isinstance(_tok, int):
        _TOKENS_USED = _tok


def _save_checkpoint() -> None:
    p = _checkpoint_path()
    if p is None:
        return
    p.parent.mkdir(parents=True, exist_ok=True)
    _snap = {
        "outputs": _OUT,
        "completed": list(_COMPLETED),
        "stack": _STACK,
        "out_live": _OUTPUT,
        "memo": _MEMO,
        "tokens_used": _TOKENS_USED,
    }
    _fd, _tmp = tempfile.mkstemp(dir=p.parent, suffix=".tmp")
    try:
        with os.fdopen(_fd, "w", encoding="utf-8") as _fh:
            json.dump(_snap, _fh, ensure_ascii=False)
        os.replace(_tmp, p)
    except Exception:
        try:
            os.unlink(_tmp)
        except OSError:
            pass
        raise


async def _run_agent(
    provider: object,
    model: str,
    system_prompt: str,
    prompt: str,
    tools: tuple[AgentTool, ...] = (),
    output_schema: dict[str, object] | None = None,
    web_search_model: str | None = None,
) -> tuple[object, int]:
    stream_fn: StreamFn = stream_fn_from_provider(provider)  # type: ignore[arg-type]
    # Structured output: register submit_result + a result sink, and instruct the
    # agent to call it.  The submitted object becomes the node's structured output.
    _sink: dict[str, object] = {}
    _tool_ctx: dict[str, object] | None = None
    _sys = system_prompt
    if output_schema is not None:
        tools = tools + (create_submit_result_tool(),)
        _tool_ctx = {"flow_output_schema": output_schema, "flow_result_sink": _sink}
        _props = output_schema.get("properties")
        _fields = ", ".join(_props) if isinstance(_props, dict) else "the required fields"
        _sys = system_prompt + (
            "\nWhen finished, you MUST call the submit_result tool"
            f" with an object containing these fields: {_fields}."
        )
    # Built-in web_search tool (search model may differ from the node model).
    _web_search_fn: Callable[[str], Awaitable[str]] | None = None
    if web_search_model is not None:
        _web_search_fn = web_search_fn_from_provider(provider, web_search_model)  # type: ignore[arg-type]
    agent = Agent(
        stream_fn,
        config=AgentConfig(model=model, system_prompt=_sys),
        tools=tools,
        tool_ctx=_tool_ctx,
        web_search_fn=_web_search_fn,
    )
    accumulated: list[str] = []
    _node_tokens = 0
    event_stream = await agent.prompt(prompt)
    async for event in event_stream:
        if isinstance(event, TurnEndEvent) and event.message is not None:
            msg = event.message
            if isinstance(msg, AssistantMessage):
                for part in msg.content:
                    if isinstance(part, TextContent):
                        accumulated.append(part.text)
                _u = msg.usage
                # Mirrors flow.executor's token accounting: some providers leave
                # total_tokens at 0 but fill input/output, so fall back to their sum.
                _node_tokens += _u.total_tokens or (_u.input + _u.output)
    if output_schema is not None:
        _result_obj = _sink.get("result")
        if _result_obj is None:
            raise WorkflowExecutionError("agent did not submit a result via submit_result")
        # Keep the submitted object structured — do NOT flatten to a JSON string.
        return _result_obj, _node_tokens
    return "".join(accumulated), _node_tokens


async def _drive(
    node_id: str,
    node_fn: "Callable[..., Awaitable[tuple[dict[str, object], int]]]",
    inputs_fn: "Callable[[], dict[str, object]]",
    store_fn: "Callable[[dict[str, object], dict[str, object]], None]",
    *,
    retry_max: int,
    backoff: float,
    deterministic: bool,
    isolate: bool,
    isolated_succs: tuple[str, ...],
) -> None:
    """Generic node driver: guards, inputs, memo, retry, store, budget, checkpoint.

    ``node_fn`` is the pure node function (``provider, ctx, **inputs`` ->
    ``(outputs, tokens)``); ``inputs_fn`` assembles ``ins`` from ``_OUT``;
    ``store_fn(ins, outputs)`` writes ``_OUT``/``_OUTPUT``.  Mirrors the
    interpreter's ``_run_node``.
    """
    global _TOKENS_USED
    if node_id in _COMPLETED or node_id in _ISOLATED:
        return
    ins = inputs_fn()

    if deterministic:
        _mk = f"{node_id}:{hashlib.sha256(json.dumps(ins, sort_keys=True).encode()).hexdigest()}"
        if _mk in _MEMO:
            _EVENT_LOG.info("NodeStarted node=%s step=%d", node_id, len(_STACK))
            _t0m = time.monotonic()
            _OUT[node_id] = dict(_MEMO[_mk])
            _STACK.append({"step": len(_STACK), "node": node_id, "in": dict(ins), "out": dict(_OUT[node_id])})
            _COMPLETED.add(node_id)
            _save_checkpoint()
            _EVENT_LOG.info(
                "NodeFinished node=%s step=%d duration_s=%f", node_id, len(_STACK) - 1, time.monotonic() - _t0m
            )
            return

    _EVENT_LOG.info("NodeStarted node=%s step=%d", node_id, len(_STACK))
    _t0 = time.monotonic()
    _last_exc: BaseException | None = None
    _outputs: dict[str, object] = {}
    _tokens = 0
    _ctx = RuntimeContext(step=len(_STACK), node_id=node_id, workflow_name=_WORKFLOW_NAME)
    for _attempt in range(retry_max):
        try:
            _outputs, _tokens = await node_fn(provider=_PROVIDER, ctx=_ctx, **ins)
            _last_exc = None
            break
        except Exception as _exc:  # not BaseException: never retry Cancelled/KeyboardInterrupt
            _last_exc = _exc
            if _attempt + 1 < retry_max and backoff > 0:
                await asyncio.sleep(backoff * (_attempt + 1))
    try:
        if _last_exc is not None:
            raise _last_exc
        store_fn(ins, _outputs)
        _TOKENS_USED += _tokens
        _STACK.append({"step": len(_STACK), "node": node_id, "in": dict(ins), "out": dict(_OUT.get(node_id, {}))})
        if deterministic:
            _MEMO[_mk] = dict(_OUT.get(node_id, {}))
        _COMPLETED.add(node_id)
        _save_checkpoint()
        _EVENT_LOG.info(
            "NodeFinished node=%s step=%d duration_s=%f", node_id, len(_STACK) - 1, time.monotonic() - _t0
        )
        if _MAX_TOKENS is not None and _MAX_TOKENS > 0 and _TOKENS_USED > _MAX_TOKENS:
            raise WorkflowBudgetExceeded(_TOKENS_USED, _MAX_TOKENS)  # type: ignore[arg-type]
    except BaseException as _ev_exc:
        _EVENT_LOG.info(
            "NodeFailed node=%s step=%d duration_s=%f error=%s",
            node_id, len(_STACK), time.monotonic() - _t0, f"{type(_ev_exc).__name__}: {_ev_exc}",
        )
        if isolate and not isinstance(
            _ev_exc, (WorkflowBudgetExceeded, KeyboardInterrupt, SystemExit, asyncio.CancelledError)
        ):
            _FAILED[node_id] = f"{type(_ev_exc).__name__}: {_ev_exc}"
            _ISOLATED.add(node_id)
            for _succ in isolated_succs:
                _ISOLATED.add(_succ)
            return
        raise


async def _drive_fan(
    node_id: str,
    node_fn: "Callable[..., Awaitable[tuple[dict[str, object], int]]]",
    inputs_fn: "Callable[[], dict[str, object]]",
    store_fn: "Callable[[dict[str, object], dict[str, object]], None]",
    fan_port: str,
    out_ports: tuple[str, ...],
    fan_cap: int = 0,
) -> None:
    """Dynamic fan-out driver (G1): run *node_fn* once per element of the array in
    ``ins[fan_port]`` and aggregate each output port into an index-ordered list.

    From the scheduler's view this is still ONE node (one completed id, one frame,
    one checkpoint entry).  Mirrors the interpreter's ``_run_fan_node``.  A dedicated
    ``fan_cap`` semaphore limits how many instances run at once (0 = unlimited); it
    is independent of any scheduler semaphore (re-acquiring that here would deadlock).
    """
    global _TOKENS_USED
    if node_id in _COMPLETED or node_id in _ISOLATED:
        return
    ins = inputs_fn()
    _raw = ins.get(fan_port)
    _items: list[object] = list(_raw) if isinstance(_raw, (list, tuple)) else []
    _EVENT_LOG.info("NodeStarted node=%s step=%d", node_id, len(_STACK))
    _t0 = time.monotonic()
    _ctx = RuntimeContext(step=len(_STACK), node_id=node_id, workflow_name=_WORKFLOW_NAME)
    _fan_sem: asyncio.Semaphore | None = asyncio.Semaphore(fan_cap) if fan_cap > 0 else None

    async def _one(_x: object) -> tuple[dict[str, object], int]:
        if _fan_sem is None:
            return await node_fn(provider=_PROVIDER, ctx=_ctx, **{**ins, fan_port: _x})
        async with _fan_sem:
            return await node_fn(provider=_PROVIDER, ctx=_ctx, **{**ins, fan_port: _x})

    _results = await asyncio.gather(*[_one(_x) for _x in _items])
    _agg: dict[str, object] = {_p: [r[0].get(_p) for r in _results] for _p in out_ports}
    _tokens = sum(r[1] for r in _results)
    store_fn(ins, _agg)
    _TOKENS_USED += _tokens
    _STACK.append({"step": len(_STACK), "node": node_id, "in": dict(ins), "out": dict(_OUT.get(node_id, {}))})
    _COMPLETED.add(node_id)
    _save_checkpoint()
    _EVENT_LOG.info(
        "NodeFinished node=%s step=%d duration_s=%f", node_id, len(_STACK) - 1, time.monotonic() - _t0
    )
    if _MAX_TOKENS is not None and _MAX_TOKENS > 0 and _TOKENS_USED > _MAX_TOKENS:
        raise WorkflowBudgetExceeded(_TOKENS_USED, _MAX_TOKENS)  # type: ignore[arg-type]


$node_functions


async def main() -> None:
    global _FLOW_RUN_ID, _FLOW_CHECKPOINT_DIR
    _FLOW_RUN_ID = os.environ.get("FLOW_RUN_ID")
    _FLOW_CHECKPOINT_DIR = os.environ.get("FLOW_CHECKPOINT_DIR")
    _load_checkpoint()
$signals_main_init
    global _MAX_TOKENS, _TOKENS_USED
    _raw_max_tokens = os.environ.get("FLOW_MAX_TOKENS", "")
    _MAX_TOKENS = int(_raw_max_tokens) if _raw_max_tokens.strip().isdigit() else None
    # Run-time overrides (parity with the interpreter's --input / --provider):
    # FLOW_INPUTS is a JSON object merged into the initial state; FLOW_PROVIDER
    # swaps the provider.
    _raw_inputs = os.environ.get("FLOW_INPUTS", "")
    if _raw_inputs.strip():
        _OUT[$in_node_id].update(json.loads(_raw_inputs))
    provider = ai.provider(os.environ.get("FLOW_PROVIDER") or "$provider")
    global _PROVIDER
    _PROVIDER = provider
$main_body
    _last = _STACK[-1] if _STACK else {"step": -1, "node": ""}
    _RUNTIME.update(
        {
            "ctx": {"step": _last["step"], "node_id": _last["node"], "workflow_name": "$workflow_name"},
            "stack": _STACK,
            "state": {_k: _v for _k, _v in _OUT.items() if _k != $in_node_id},
            "in": _OUT[$in_node_id],
            "out": _OUTPUT,
            "failed": _FAILED,
            "memo": _MEMO,
            "tokens_used": _TOKENS_USED,
        }
    )
    print(json.dumps(_RUNTIME["out"] if _RUNTIME["out"] else _RUNTIME, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    import sys

    if "-v" in sys.argv or "--verbose" in sys.argv:
        # Surface the P3 node lifecycle events (NodeStarted / NodeFinished /
        # NodeFailed) that this module logs to "flow.generated.events".  Off by
        # default so a plain run only prints the workflow's JSON output.
        logging.basicConfig(level=logging.INFO, format="%(message)s")
    asyncio.run(main())
