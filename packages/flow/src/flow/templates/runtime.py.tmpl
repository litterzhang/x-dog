# ---------------------------------------------------------------------------
# CLI agent backend: shell out to a coding-agent CLI for one turn (no agent/ai).
# Mirrors flow.runners.CliRunner + the claude/codex adapters; kept in lock-step
# with the interpreter by the interpret==compile parity tests.
# ---------------------------------------------------------------------------
_CLI_ENV_RE = re.compile(r"\$$\{([A-Za-z_][A-Za-z0-9_]*)\}")


def _cli_resolve_env(value: object) -> object:
    if isinstance(value, str):
        def _sub(_m: "re.Match[str]") -> str:
            _v = os.environ.get(_m.group(1))
            if _v is None:
                raise WorkflowExecutionError(f"mcp_servers: environment variable $${{{_m.group(1)}}} is not set")
            return _v
        return _CLI_ENV_RE.sub(_sub, value)
    if isinstance(value, dict):
        return {_k: _cli_resolve_env(_v) for _k, _v in value.items()}
    if isinstance(value, list):
        return [_cli_resolve_env(_v) for _v in value]
    return value


def _cli_toml_value(value: object) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list):
        return "[" + ", ".join(_cli_toml_value(_v) for _v in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(f"{_k} = {_cli_toml_value(_v)}" for _k, _v in value.items()) + "}"
    return json.dumps(str(value))


def _claude_mcp_config(mcp_servers: "list") -> str:
    _servers = {_name: _cli_resolve_env(_spec) for _name, _spec in mcp_servers}
    return json.dumps({"mcpServers": _servers}, sort_keys=True)


def _codex_mcp_config(mcp_servers: "list") -> str:
    _lines: "list[str]" = []
    for _name, _spec in mcp_servers:
        _lines.append(f"[mcp_servers.{_name}]")
        for _key, _raw in _spec.items():
            _lines.append(f"{_key} = {_cli_toml_value(_cli_resolve_env(_raw))}")
        _lines.append("")
    return "\n".join(_lines)


def _cli_binary(backend: str) -> str:
    _env = "FLOW_CLI_BIN_" + backend.upper().replace("-", "_")
    _default = {"claude-cli": "claude", "codex-cli": "codex"}.get(backend, backend)
    return os.environ.get(_env) or os.environ.get("FLOW_CLI_BIN") or _default


def _cli_argv(
    backend: str,
    model: str,
    system_prompt: str,
    output_schema: dict[str, object] | None,
    allowed_tools: "tuple[str, ...]",
    mcp_servers: "list",
    scratch: Path,
) -> "list[str]":
    if backend == "claude-cli":
        _args = ["-p", "--output-format", "json"]
        if model:
            _args += ["--model", model]
        if system_prompt:
            _args += ["--append-system-prompt", system_prompt]
        if output_schema is not None:
            _args += ["--json-schema", json.dumps(output_schema, sort_keys=True)]
        if mcp_servers:
            _cfg = scratch / "mcp.json"
            _cfg.write_text(_claude_mcp_config(mcp_servers), encoding="utf-8")
            _args += ["--mcp-config", str(_cfg)]
        if allowed_tools:
            _args += ["--allowedTools", ",".join(allowed_tools)]
        return _args
    if backend == "codex-cli":
        _args = ["exec", "--json", "--skip-git-repo-check"]
        if model:
            _args += ["-m", model]
        if output_schema is not None:
            _sf = scratch / "output_schema.json"
            _sf.write_text(json.dumps(output_schema, sort_keys=True), encoding="utf-8")
            _args += ["--output-schema", str(_sf)]
        if mcp_servers:
            (scratch / "config.toml").write_text(_codex_mcp_config(mcp_servers), encoding="utf-8")
        return _args
    raise WorkflowExecutionError(f"unknown CLI backend {backend!r}")


def _cli_stdin(backend: str, system_prompt: str, user_prompt: str) -> str:
    if backend == "codex-cli" and system_prompt:
        return f"{system_prompt}\n\n{user_prompt}"
    return user_prompt


def _cli_parse(backend: str, stdout: str, structured: bool) -> tuple[object, int]:
    if backend == "claude-cli":
        _env = json.loads(stdout)
        if not isinstance(_env, dict):
            raise WorkflowExecutionError("claude-cli: unexpected output (not a JSON object)")
        _usage = _env.get("usage") if isinstance(_env.get("usage"), dict) else _env
        _i, _o = _usage.get("input_tokens"), _usage.get("output_tokens")
        _tok = (int(_i) if isinstance(_i, int) else 0) + (int(_o) if isinstance(_o, int) else 0)
        if structured:
            _obj = _env.get("structured_output")
            if _obj is None:
                raise WorkflowExecutionError("claude-cli: no structured_output in response")
            return _obj, _tok
        _res = _env.get("result", "")
        return (_res if isinstance(_res, str) else json.dumps(_res)), _tok
    if backend == "codex-cli":
        _final: str | None = None
        _tok = 0
        for _line in stdout.splitlines():
            _line = _line.strip()
            if not _line:
                continue
            try:
                _ev = json.loads(_line)
            except json.JSONDecodeError:
                continue
            if not isinstance(_ev, dict):
                continue
            if _ev.get("type") == "item.completed":
                _it = _ev.get("item")
                if isinstance(_it, dict) and _it.get("type") == "agent_message" and isinstance(_it.get("text"), str):
                    _final = _it["text"]
            elif _ev.get("type") == "turn.completed":
                _u = _ev.get("usage")
                if isinstance(_u, dict):
                    _i, _o = _u.get("input_tokens"), _u.get("output_tokens")
                    _tok = (int(_i) if isinstance(_i, int) else 0) + (int(_o) if isinstance(_o, int) else 0)
        if _final is None:
            raise WorkflowExecutionError("codex-cli: no agent_message in output")
        if structured:
            return json.loads(_final), _tok
        return _final, _tok
    raise WorkflowExecutionError(f"unknown CLI backend {backend!r}")


async def _run_cli_agent(
    backend: str,
    model: str,
    system_prompt: str,
    user_prompt: str,
    output_schema: dict[str, object] | None,
    allowed_tools: "tuple[str, ...]",
    mcp_servers: "list",
) -> tuple[object, int]:
    _structured = output_schema is not None
    _scratch = Path(tempfile.mkdtemp(prefix="flow-cli-"))
    try:
        _argv = _cli_argv(backend, model, system_prompt, output_schema, allowed_tools, mcp_servers, _scratch)
        _stdin = _cli_stdin(backend, system_prompt, user_prompt)
        _bin = _cli_binary(backend)
        _env = None
        if mcp_servers and backend == "codex-cli":
            _env = {**os.environ, "CODEX_HOME": str(_scratch)}
        _proc = await asyncio.create_subprocess_exec(
            _bin, *_argv,
            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
            env=_env,
        )
        _out_b, _err_b = await _proc.communicate(_stdin.encode())
        if _proc.returncode != 0:
            _err = _err_b.decode(errors="replace").strip()
            raise WorkflowExecutionError(f"CLI {_bin!r} exited {_proc.returncode}: {_err or '(no stderr)'}")
        return _cli_parse(backend, _out_b.decode(errors="replace"), _structured)
    finally:
        shutil.rmtree(_scratch, ignore_errors=True)


async def _drive(
    node_id: str,
    node_fn: "Callable[..., Awaitable[tuple[dict[str, object], int]]]",
    inputs_fn: "Callable[[], dict[str, object]]",
    store_fn: "Callable[[dict[str, object], dict[str, object]], None]",
    *,
    retry_max: int,
    backoff: float,
    deterministic: bool,
    isolate: bool,
    isolated_succs: tuple[str, ...],
) -> None:
    """Generic node driver: guards, inputs, memo, retry, store, budget, checkpoint.

    ``node_fn`` is the pure node function (``provider, ctx, **inputs`` ->
    ``(outputs, tokens)``); ``inputs_fn`` assembles ``ins`` from ``_OUT``;
    ``store_fn(ins, outputs)`` writes ``_OUT``/``_OUTPUT``.  Mirrors the
    interpreter's ``_run_node``.
    """
    global _TOKENS_USED
    if node_id in _COMPLETED or node_id in _ISOLATED:
        return
    ins = inputs_fn()

    if deterministic:
        _mk = f"{node_id}:{hashlib.sha256(json.dumps(ins, sort_keys=True).encode()).hexdigest()}"
        if _mk in _MEMO:
            _EVENT_LOG.info("NodeStarted node=%s step=%d", node_id, len(_STACK))
            _t0m = time.monotonic()
            _OUT[node_id] = dict(_MEMO[_mk])
            _STACK.append({"step": len(_STACK), "node": node_id, "in": dict(ins), "out": dict(_OUT[node_id])})
            _COMPLETED.add(node_id)
            _save_checkpoint()
            _EVENT_LOG.info(
                "NodeFinished node=%s step=%d duration_s=%f", node_id, len(_STACK) - 1, time.monotonic() - _t0m
            )
            return

    _EVENT_LOG.info("NodeStarted node=%s step=%d", node_id, len(_STACK))
    _t0 = time.monotonic()
    _last_exc: BaseException | None = None
    _outputs: dict[str, object] = {}
    _tokens = 0
    _ctx = RuntimeContext(step=len(_STACK), node_id=node_id, workflow_name=_WORKFLOW_NAME)
    for _attempt in range(retry_max):
        try:
            _outputs, _tokens = await node_fn(provider=_PROVIDER, ctx=_ctx, **ins)
            _last_exc = None
            break
        except Exception as _exc:  # not BaseException: never retry Cancelled/KeyboardInterrupt
            _last_exc = _exc
            if _attempt + 1 < retry_max and backoff > 0:
                await asyncio.sleep(backoff * (_attempt + 1))
    try:
        if _last_exc is not None:
            raise _last_exc
        store_fn(ins, _outputs)
        _TOKENS_USED += _tokens
        _STACK.append({"step": len(_STACK), "node": node_id, "in": dict(ins), "out": dict(_OUT.get(node_id, {}))})
        if deterministic:
            _MEMO[_mk] = dict(_OUT.get(node_id, {}))
        _COMPLETED.add(node_id)
        _save_checkpoint()
        _EVENT_LOG.info(
            "NodeFinished node=%s step=%d duration_s=%f", node_id, len(_STACK) - 1, time.monotonic() - _t0
        )
        if _MAX_TOKENS is not None and _MAX_TOKENS > 0 and _TOKENS_USED > _MAX_TOKENS:
            raise WorkflowBudgetExceeded(_TOKENS_USED, _MAX_TOKENS)  # type: ignore[arg-type]
    except BaseException as _ev_exc:
        _EVENT_LOG.info(
            "NodeFailed node=%s step=%d duration_s=%f error=%s",
            node_id, len(_STACK), time.monotonic() - _t0, f"{type(_ev_exc).__name__}: {_ev_exc}",
        )
        if isolate and not isinstance(
            _ev_exc, (WorkflowBudgetExceeded, KeyboardInterrupt, SystemExit, asyncio.CancelledError)
        ):
            _FAILED[node_id] = f"{type(_ev_exc).__name__}: {_ev_exc}"
            _ISOLATED.add(node_id)
            for _succ in isolated_succs:
                _ISOLATED.add(_succ)
            return
        raise


async def _drive_fan(
    node_id: str,
    node_fn: "Callable[..., Awaitable[tuple[dict[str, object], int]]]",
    inputs_fn: "Callable[[], dict[str, object]]",
    store_fn: "Callable[[dict[str, object], dict[str, object]], None]",
    fan_port: str,
    out_ports: tuple[str, ...],
    fan_cap: int = 0,
) -> None:
    """Dynamic fan-out driver (G1): run *node_fn* once per element of the array in
    ``ins[fan_port]`` and aggregate each output port into an index-ordered list.

    From the scheduler's view this is still ONE node (one completed id, one frame,
    one checkpoint entry).  Mirrors the interpreter's ``_run_fan_node``.  A dedicated
    ``fan_cap`` semaphore limits how many instances run at once (0 = unlimited); it
    is independent of any scheduler semaphore (re-acquiring that here would deadlock).
    """
    global _TOKENS_USED
    if node_id in _COMPLETED or node_id in _ISOLATED:
        return
    ins = inputs_fn()
    _raw = ins.get(fan_port)
    _items: list[object] = list(_raw) if isinstance(_raw, (list, tuple)) else []
    _EVENT_LOG.info("NodeStarted node=%s step=%d", node_id, len(_STACK))
    _t0 = time.monotonic()
    _ctx = RuntimeContext(step=len(_STACK), node_id=node_id, workflow_name=_WORKFLOW_NAME)
    _fan_sem: asyncio.Semaphore | None = asyncio.Semaphore(fan_cap) if fan_cap > 0 else None

    async def _one(_x: object) -> tuple[dict[str, object], int]:
        if _fan_sem is None:
            return await node_fn(provider=_PROVIDER, ctx=_ctx, **{**ins, fan_port: _x})
        async with _fan_sem:
            return await node_fn(provider=_PROVIDER, ctx=_ctx, **{**ins, fan_port: _x})

    _results = await asyncio.gather(*[_one(_x) for _x in _items])
    _agg: dict[str, object] = {_p: [r[0].get(_p) for r in _results] for _p in out_ports}
    _tokens = sum(r[1] for r in _results)
    store_fn(ins, _agg)
    _TOKENS_USED += _tokens
    _STACK.append({"step": len(_STACK), "node": node_id, "in": dict(ins), "out": dict(_OUT.get(node_id, {}))})
    _COMPLETED.add(node_id)
    _save_checkpoint()
    _EVENT_LOG.info(
        "NodeFinished node=%s step=%d duration_s=%f", node_id, len(_STACK) - 1, time.monotonic() - _t0
    )
    if _MAX_TOKENS is not None and _MAX_TOKENS > 0 and _TOKENS_USED > _MAX_TOKENS:
        raise WorkflowBudgetExceeded(_TOKENS_USED, _MAX_TOKENS)  # type: ignore[arg-type]


