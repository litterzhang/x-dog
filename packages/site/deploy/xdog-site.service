[Unit]
PartOf=zdog.target
Description=xdog Site Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zhang/workspaces/pyspace/xdog
Environment=XDOG_SITE_HOST=127.0.0.1
Environment=XDOG_SITE_PORT=8080
Environment=XDOG_SITE_DEV=1
ExecStart=/home/zhang/workspaces/pyspace/xdog/.venv/bin/xdog-site
Restart=always
RestartSec=10

[Install]
WantedBy=zdog.target
