[Unit]
PartOf=zdog.target
Description=x-dog Site Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zhang/workspaces/pyspace/x-dog
Environment=XDOG_SITE_HOST=127.0.0.1
Environment=XDOG_SITE_PORT=8080
ExecStart=/home/zhang/workspaces/pyspace/x-dog/.venv/bin/xdog-site
Restart=always
RestartSec=10

[Install]
WantedBy=zdog.target
